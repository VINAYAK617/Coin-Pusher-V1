<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net5.0</TargetFramework>
    <RunPostBuildEvent>Always</RunPostBuildEvent>
	  <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameEngine\GameEngine.csproj" />
    <ProjectReference Include="..\Profiles\Profile1\ALW-Coin-Pusher.csproj" />
    <ProjectReference Include="..\TicketChecker\TicketChecker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="NeoComboGenerator">
      <HintPath>..\Resources\NeoComboGenerator.dll</HintPath>
    </Reference>
    <Reference Include="NeoCore">
      <HintPath>..\Resources\NeoCore.dll</HintPath>
    </Reference>
  </ItemGroup>

<Target Name="MoveProfilesAfterBuild" AfterTargets="Build">
  <Exec Condition="'$(OS)' == 'Windows_NT'"
        Command="call &quot;$(SolutionDir)Scripts\MoveProfile.bat&quot; &quot;$(SolutionDir)&quot; &quot;$(ProjectDir)&quot; &quot;$(Configuration)&quot; &quot;net5.0&quot; &quot;false&quot;" />

  <Exec Condition="'$(OS)' != 'Windows_NT'"
        Command="bash &quot;$(ProjectDir)../Scripts/MoveProfile.sh&quot; &quot;$(ProjectDir)../&quot; &quot;$(ProjectDir)&quot; &quot;$(Configuration)&quot; &quot;net5.0&quot; &quot;false&quot;" />
</Target>

</Project>
